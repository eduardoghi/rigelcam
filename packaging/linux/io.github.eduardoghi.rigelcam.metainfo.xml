<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.eduardoghi.rigelcam</id>
  <name>Rigelcam</name>
  <summary>Watch cameras and recordings from Intelbras and Dahua recorders</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.eduardoghi">
    <name>Eduardo Hillesheim</name>
  </developer>
  <description>
    <p>
      Rigelcam talks directly to Intelbras and Dahua NVRs, with no vendor software or cloud account.
      It shows a grid of live cameras and plays recordings by day, with up to 4 cameras in sync.
    </p>
    <p>
      An independent project, not affiliated with Intelbras or Dahua.
    </p>
  </description>
  <launchable type="desktop-id">io.github.eduardoghi.rigelcam.desktop</launchable>
  <url type="homepage">https://github.com/eduardoghi/rigelcam</url>
  <url type="bugtracker">https://github.com/eduardoghi/rigelcam/issues</url>
  <screenshots>
    <screenshot type="default">
      <caption>Live grid with nine cameras</caption>
      <image>https://raw.githubusercontent.com/eduardoghi/rigelcam/main/assets/screenshots/live.jpg</image>
    </screenshot>
    <screenshot>
      <caption>Recordings of one camera, with events on the timeline</caption>
      <image>https://raw.githubusercontent.com/eduardoghi/rigelcam/main/assets/screenshots/recordings.jpg</image>
    </screenshot>
    <screenshot>
      <caption>One camera on its own, from the main stream</caption>
      <image>https://raw.githubusercontent.com/eduardoghi/rigelcam/main/assets/screenshots/camera.jpg</image>
    </screenshot>
    <screenshot>
      <caption>The light theme</caption>
      <image>https://raw.githubusercontent.com/eduardoghi/rigelcam/main/assets/screenshots/light.jpg</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
